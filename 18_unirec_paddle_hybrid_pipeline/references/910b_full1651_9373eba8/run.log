t2 = (n1 - 1)/fs;
% 时间刻度
arc = pi/180;
% 1 rad
Am = [0.15 10 0.11];
% 幅值参数
Fr = [48.08 49.72 51.36];
% 频率参数
Theta = [73 32 - 13];
% 初始相角参数(度)
x = zeros(1,N);
% 数据初始化
% 产生信号
for k = 1 : 3
x = x + Am(k) * cos(2 * pi * Fr(k) * t2 + Theta(k) * arc); % 信号
end
% ZFFT
% 细化倍数和中心频率
D = 128; fe = 50;
% nfft 长
nfft = 256;
% ZFFT
[y, frequ, xx] = exzfft_ma(x, fe, fs, nfft, D);
% 校正分析
fsl = fs/D;
% 频率刻度第 1 点的值
fi = frequ(1);
% 设置 L 和 M
Nw = 256; Lw = 32;
% 按时域平移相位差校正法计算
% 检测第 1 个分量
Z = phase1_afterexzfft(xx,fi,Nw,Lw,fs1,47.5,49);
fprintf('% 5.6f % 5.6f % 5.6f\n',Z(1),Z(2),Z(3)/arc)
Z = phase1_afterexzfft(xx,fi,Nw,Lw,fs1,49,50.5);
% 检测第 2 个分量
fprintf('% 5.6f % 5.6f % 5.6f\n',Z(1),Z(2),Z(3)/arc)
Z = phase1_afterexzfft(xx,fi,Nw,Lw,fs1,50.5,52);
% 检测第 3 个分量
fprintf('% 5.6f % 5.6f % 5.6f\n',Z(1),Z(2),Z(3)/arc)

