  {
    "type": "equation",
    "bbox": [
      0.097,
      0.554,
      0.877,
      0.863
    ],
    "angle": 0,
    "content": "\\[\n\\begin{array}{l} h (x _ {t}, z _ {t + 1}) \\leq h (x _ {t}, z _ {t}) + \\langle \\nabla_ {y y} ^ {2} G (x _ {t}, y _ {t}; \\zeta_ {t}) z _ {t} - \\nabla_ {y} F (x _ {t}, y _ {t}; \\xi_ {t}), z _ {t + 1} - z _ {t} \\rangle + \\frac {l _ {g , 1}}{2} \\| z _ {t + 1} - z _ {t} \\| ^ {2} \\\\ + \\langle [ \\nabla_ {y y} ^ {2} g (x _ {t}, y _ {t} ^ {*}) - \\nabla_ {y y} ^ {2} g (x _ {t}, y _ {t}) ] z _ {t}, z _ {t + 1} - z _ {t} \\rangle + \\langle [ \\nabla_ {y} f (x _ {t}, y _ {t}) - \\nabla_ {y} f (x _ {t}, y _ {t} ^ {*}) ], z _ {t + 1} - z _ {t} \\rangle \\\\ + \\langle v _ {t}, z _ {t + 1} - z _ {t} \\rangle \\\\ \\leq h (x _ {t}, z _ {t}) + \\langle \\nabla_ {y y} ^ {2} G (x _ {t}, y _ {t}; \\zeta_ {t}) z _ {t} - \\nabla_ {y} F (x _ {t}, y _ {t}; \\xi_ {t}), z _ {t + 1} - z _ {t} \\rangle + \\frac {\\delta_ {t} ^ {- 1} + l _ {g , 1} + 2 (4 \\gamma) ^ {- 1}}{2} \\| z _ {t + 1} - z _ {t} \\| ^ {2} + \\frac {\\delta_ {t}}{2} \\| v _ {t} \\| ^ {2} \\\\ + 4 \\gamma l _ {g, 2} ^ {2} \\| y _ {t} - y _ {t} ^ {*} \\| ^ {2} \\| z _ {t} - z _ {t} ^ {*} \\| ^ {2} + 4 \\gamma \\frac {l _ {g , 2} ^ {2} l _ {f , 0} ^ {2}}{\\mu^ {2}} \\| y _ {t} - y _ {t} ^ {*} \\| ^ {2} + 2 \\gamma (L _ {y, 0} + L _ {y, 1} l _ {f, 0}) ^ {2} \\| y _ {t} - y _ {t} ^ {*} \\| ^ {2} \\\\ \\leq h \\left(x _ {t}, z _ {t}\\right) + \\left\\langle \\nabla_ {y y} ^ {2} G \\left(x _ {t}, y _ {t}; \\zeta_ {t}\\right) z _ {t} - \\nabla_ {y} F \\left(x _ {t}, y _ {t}; \\xi_ {t}\\right), z _ {t + 1} - z _ {t} \\right\\rangle + \\frac {1}{2 \\gamma} \\left\\| z _ {t + 1} - z _ {t} \\right\\| ^ {2} \\\\ + \\frac {\\delta_ {t} ^ {- 1} + l _ {g , 1} + (2 \\gamma) ^ {- 1} - \\gamma^ {- 1}}{2} \\| z _ {t + 1} - z _ {t} \\| ^ {2} + \\frac {\\delta_ {t}}{2} \\| v _ {t} \\| ^ {2} \\\\ + 4 \\gamma l _ {g, 2} ^ {2} \\| y _ {t} - y _ {t} ^ {*} \\| ^ {2} \\| z _ {t} - z _ {t} ^ {*} \\| ^ {2} + 4 \\gamma \\frac {l _ {g , 2} ^ {2} l _ {f , 0} ^ {2}}{\\mu^ {2}} \\| y _ {t} - y _ {t} ^ {*} \\| ^ {2} + 2 \\gamma (L _ {y, 0} + L _ {y, 1} l _ {f, 0}) ^ {2} \\| y _ {t} - y _ {t} ^ {*} \\| ^ {2} \\\\ \\leq h (x _ {t}, z _ {t}) + \\langle \\nabla_ {y y} ^ {2} G (x _ {t}, y _ {t}; \\zeta_ {t}) z _ {t} - \\nabla_ {y} F (x _ {t}, y _ {t}; \\xi_ {t}), z - z _ {t} \\rangle + \\frac {1}{2 \\gamma} \\| z - z _ {t} \\| ^ {2} - \\frac {1}{2 \\gamma} \\| z - z _ {t + 1} \\| ^ {2} \\\\ + \\frac {\\delta_ {t} ^ {- 1} + l _ {g , 1} - (2 \\gamma) ^ {- 1}}{2} \\| z _ {t + 1} - z _ {t} \\| ^ {2} + \\frac {\\delta_ {t}}{2} \\| v _ {t} \\| ^ {2} \\\\ + 4 \\gamma l _ {g, 2} ^ {2} \\| y _ {t} - y _ {t} ^ {*} \\| ^ {2} \\| z _ {t} - z _ {t} ^ {*} \\| ^ {2} + 4 \\gamma \\frac {l _ {g , 2} ^ {2} l _ {f , 0} ^ {2}}{\\mu^ {2}} \\| y _ {t} - y _ {t} ^ {*} \\| ^ {2} + 2 \\gamma (L _ {y, 0} + L _ {y, 1} l _ {f, 0}) ^ {2} \\| y _ {t} - y _ {t} ^ {*} \\| ^ {2} \\\\ \\end{array}\n\\]"
  },
