    ],
    "angle": 0,
    "content": "\\[\n= \\frac {1}{x} \\int_ {0} ^ {x} \\cos t \\mathrm{d} t = \\frac {1}{x} \\sin t \\bigg | _ {0} ^ {x} = \\frac {\\sin x}{x};\n\\]"
  },
  {
