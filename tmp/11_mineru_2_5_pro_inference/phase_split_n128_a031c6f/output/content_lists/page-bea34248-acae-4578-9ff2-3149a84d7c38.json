      0.389
    ],
    "angle": 0,
    "content": "当 \\(x < 0\\) 时，\\(f(x) = f(-x) = \\frac{\\sin(-x)}{-x} = \\frac{\\sin x}{x}\\).",
    "merge_prev": false
  },
  {
